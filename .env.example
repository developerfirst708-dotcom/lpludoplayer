# ---- copy to apps/api/.env and edit ----
# Never commit your real .env.

NODE_ENV=development
PORT=5000

# Mongo must be a REPLICA SET — every money mutation uses transactions.
# Local dev: docker-compose.dev.yml (single-node replica set on 27018).
# Production: any managed replica set works, e.g. MongoDB Atlas —
#   mongodb+srv://user:pass@cluster.mongodb.net/lpludo_prod?retryWrites=true&w=majority
# (URL-encode special characters in the password.)
MONGO_URI=mongodb://localhost:27018/lpludo_dev?replicaSet=rs0

# Local redis (docker compose)
REDIS_URL=redis://localhost:6379

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-access-secret
JWT_REFRESH_SECRET=replace-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Dev convenience: when true, OTPs are printed to the API log instead of sent by SMS.
# NEVER set to true outside local development.
ALLOW_DEV_OTP=true
# Optional master OTP for local testing only. Leave empty in production.
DEV_MASTER_OTP=

# ---- OTP delivery (MeraOTP) ----
# Login OTPs are sent by SMS through MeraOTP — the provider the legacy app used.
# Without MERAOTP_API_KEY the OTP is only written to the API log (and, in local
# dev with ALLOW_DEV_OTP=true, returned in the response), so nobody can log in.
MERAOTP_API_KEY=
MERAOTP_URL=https://meraotp.in/api/sendSMS
MERAOTP_SENDER_ID=MRAOTP
MERAOTP_BRAND_NAME=LPLUDO
MERAOTP_MESSAGE_TYPE=AUTH_OTP
MERAOTP_TIMEOUT_MS=10000

# Local storage root for battle screenshots / kyc documents
LOCAL_STORAGE_DIR=.local-storage

# ---- IMB Pay gateway (hybrid deposits) ----
# Amounts BELOW the admin-configured limit (default ₹5000) are auto-verified by
# the gateway; at/above it the manual UPI + UTR flow is used.
# Leave IMB_API_TOKEN empty to disable the gateway entirely (manual for all amounts).
IMB_API_URL=https://api.imbpay.in
IMB_API_TOKEN=
IMB_API_TIMEOUT_MS=15000
IMB_STATUS_MIN_INTERVAL_MS=10000
IMB_ORDER_GRACE_MIN=45

# Public URLs used for the post-payment redirect and the webhook.
# Production: set both to your real domains and paste
#   <PUBLIC_API_URL>/api/webhooks/imb
# into the IMB dashboard → API Credentials → Webhook URL.
# Webhooks cannot reach localhost — the 60s status sweep credits payments anyway.
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=

# Game economics (single source of truth lives in packages/shared)
CURRENCY=INR
