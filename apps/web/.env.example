# Player app (apps/web) — Vite env
#
# Local dev: leave VITE_API_URL EMPTY. vite.config.js proxies /api and
# /socket.io to http://localhost:5000, so nothing else is needed.
#
# Production (Cloudflare Pages → your project → Settings → Environment
# variables → add for both Production and Preview):
#   VITE_API_URL = https://api.lpludoplayer.com
#
# Vite inlines this at BUILD time — after changing it you must redeploy.
VITE_API_URL=
